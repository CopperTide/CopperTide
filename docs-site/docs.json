{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Shakedown",
  "colors": {
    "primary": "#a8562a",
    "light": "#d98b5a",
    "dark": "#7a3d1c"
  },
  "background": {
    "color": {
      "light": "#FBF9F5",
      "dark": "#14110E"
    }
  },
  "fonts": {
    "family": "Instrument Sans"
  },
  "favicon": "/images/coppertide-mark.png",
  "appearance": {
