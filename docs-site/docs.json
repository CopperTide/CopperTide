  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "quickstart",
          "concepts"
        ]
      },
      {
        "group": "Build worlds",
        "pages": [
          "worlds/overview",
          "worlds/templates-and-benchmarks",
          "worlds/connectors",
          "worlds/data",
          "worlds/flows-and-people",
          "worlds/monitoring",
          "worlds/runtime",
          "worlds/your-systems",
          "worlds/write-an-integration"
        ]
      },
      {
        "group": "Agents",
        "pages": [
          "agents/setups",
          "agents/claude-code-and-codex",
          "agents/models",
          "agents/deployed-agents",
          "agents/frameworks",
          "agents/orchestration"
        ]
      },
      {
        "group": "Run and read results",
        "pages": [
          "runs/experiments",
          "runs/watching",
          "runs/rewind-and-fork",
          "runs/compare-and-review",
          "runs/scenarios"
        ]
      },
      {
        "group": "Use from code",
        "pages": [
          "code/python-sdk",
          "code/mcp",
          "code/http-api"
        ]
      },
      {
        "group": "Self-host",
        "pages": [
          "self-host"
        ]
      },
      {
        "group": "Account",
        "pages": [
          "account/sign-in",
          "account/keys-and-security",
          "account/quotas"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "faq",
          "updates"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "description": "Shakedown, by CopperTide, tests agent systems before production: build a copy of the systems your agents work in, run your agent setups against scenarios, and read every step of every run."
}
